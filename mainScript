local RivalsHubScript = [[
-- Rivals | Grok Hub V2 (Verbesserter Aimbot)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Rivals | Grok Hub V2",
    LoadingTitle = "Rivals Script lädt...",
    LoadingSubtitle = "Besserer Aimbot + ESP + Fly",
    ConfigurationSaving = {Enabled = true, FolderName = "GrokRivals", FileName = "ConfigV2"},
    Discord = { Enabled = false },
    KeySystem = false
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
