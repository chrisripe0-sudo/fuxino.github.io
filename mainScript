				TextColor3 = Color3.fromRGB(15, 15, 20)
			}):Play()
		else
			TweenService:Create(tab, TweenInfo.new(0.2), {
				BackgroundColor3 = Colors.Surface2,
				TextColor3 = Colors.TextDim
			}):Play()
		end
	end
	style(ExecutorTab, tabName == "Executor")
	style(HubTab, tabName == "Script Hub")
	ExecutorContent.Visible = (tabName == "Executor")
	HubContent.Visible = (tabName == "Script Hub")
end

ExecutorTab.MouseButton1Click:Connect(function() setActiveTab("Executor") end)
HubTab.MouseButton1Click:Connect(function() setActiveTab("Script Hub") end)
setActiveTab("Executor")

