local MM2HubScript = [[
-- MM2 Grok Hub V2 | Erweiterte Version
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "MM2 | Grok Hub V2",
    LoadingTitle = "MM2 Script lädt...",
    LoadingSubtitle = "ESP • Combat • Movement • Roles",
    ConfigurationSaving = {Enabled = true, FolderName = "GrokMM2", FileName = "ConfigV2"},
    Discord = { Enabled = false },
    KeySystem = false
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

getgenv().ESPEnabled = false
getgenv().AutoGun = false
getgenv().AutoKill = false
getgenv().FlyEnabled = false
getgenv().Noclip = false
getgenv().InfJump = false
getgenv().Fullbright = false
getgenv().AntiAFK = false
getgenv().KillAura = false
getgenv().AutoShoot = false
getgenv().GunNotify = false
getgenv().SelectedPlayer = nil
getgenv().FlySpeed = 50
getgenv().WalkSpeed = 16
getgenv().JumpPower = 50
getgenv().KillAuraRange = 15

local ESPObjects = {}
local Connections = {}

local function getRole(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then return "Murderer" end
    if char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

local function getMyRole()
    return getRole(LocalPlayer)
end

local function clearESP()
    for _, v in pairs(ESPObjects) do
        if v.highlight and v.highlight.Parent then v.highlight:Destroy() end
        if v.billboard and v.billboard.Parent then v.billboard:Destroy() end
    end
    ESPObjects = {}
end

local function createESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    if not player.Character then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "MM2ESP"
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = player.Character
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MM2Name"
    billboard.Size = UDim2.new(0, 120, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = player.Character:FindFirstChild("Head") or player.Character
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0.4
    text.Parent = billboard
    ESPObjects[player] = {highlight = highlight, billboard = billboard, text = text}
end

local function updateESP()
    if not getgenv().ESPEnabled then clearESP() return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            createESP(player)
            local role = getRole(player)
            local obj = ESPObjects[player]
            if obj and obj.highlight then
                if role == "Murderer" then
                    obj.highlight.FillColor = Color3.fromRGB(255, 40, 40)
                    obj.highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                    obj.text.Text = "🔪 MURDER | " .. player.Name
                    obj.text.TextColor3 = Color3.fromRGB(255, 60, 60)
                elseif role == "Sheriff" then
                    obj.highlight.FillColor = Color3.fromRGB(40, 120, 255)
                    obj.highlight.OutlineColor = Color3.fromRGB(0, 80, 255)
                    obj.text.Text = "🔫 SHERIFF | " .. player.Name
                    obj.text.TextColor3 = Color3.fromRGB(60, 140, 255)
                else
                    obj.highlight.FillColor = Color3.fromRGB(40, 220, 40)
                    obj.highlight.OutlineColor = Color3.fromRGB(0, 180, 0)
                    obj.text.Text = player.Name
                    obj.text.TextColor3 = Color3.fromRGB(80, 255, 80)
                end
                if player.Character:FindFirstChild("Head") then obj.billboard.Adornee = player.Character.Head end
            end
        end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj.Name == "GunDrop" or obj.Name == "DroppedGun") and not obj:FindFirstChild("GunESP") then
            local hl = Instance.new("Highlight")
            hl.Name = "GunESP"
            hl.FillColor = Color3.fromRGB(255, 255, 0)
            hl.OutlineColor = Color3.fromRGB(255, 200, 0)
            hl.FillTransparency = 0.25
            hl.Parent = obj
        end
    end
end

local function grabGun()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local root = char.HumanoidRootPart
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "GunDrop" or obj.Name == "DroppedGun" then
            local target = obj:IsA("BasePart") and obj or obj:FindFirstChild("Handle")
            if target then
                if firetouchinterest then
                    pcall(function() firetouchinterest(root, target, 0) firetouchinterest(root, target, 1) end)
                else
                    root.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                end
                return true
            end
        end
    end
    return false
end

local function doKillAura()
    if not getgenv().KillAura and not getgenv().AutoKill then return end
    if getMyRole() ~= "Murderer" then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
    if knife then knife.Parent = char end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (root.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if getgenv().AutoKill or dist <= getgenv().KillAuraRange then
                    root.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1.5)
                    if knife and knife:FindFirstChild("Handle") and firetouchinterest then
                        pcall(function()
                            firetouchinterest(knife.Handle, player.Character.HumanoidRootPart, 0)
                            firetouchinterest(knife.Handle, player.Character.HumanoidRootPart, 1)
                        end)
                    end
                    task.wait(0.08)
                end
            end
        end
    end
end

local function flingPlayer(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local oldPos = root.CFrame
    local targetRoot = target.Character.HumanoidRootPart
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    local spin = Instance.new("BodyAngularVelocity")
    spin.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    spin.AngularVelocity = Vector3.new(0, 99999, 0)
    spin.Parent = root
    for i = 1, 12 do
        root.CFrame = targetRoot.CFrame
        bv.Velocity = (targetRoot.Position - root.Position).Unit * 250 + Vector3.new(0, 150, 0)
        task.wait(0.025)
    end
    bv:Destroy()
    spin:Destroy()
    task.wait(0.1)
    root.CFrame = oldPos
